{
  "name": "playlovetoys-platform",
  "private": true,
  "workspaces": ["packages/*"],
  "scripts": {
    "docs:build": "zensical build",
    "docs:build:all": "node scripts/build-docs-site.mjs",
    "docs:serve": "zensical serve",
    "check:skills": "node scripts/sync-agent-skills.mjs --check && node .agents/skills/functional-visual-testing/scripts/validate-plan.mjs tests/visual/variant-picker.plan.json && node .agents/skills/functional-visual-testing/scripts/validate-plan.test.mjs",
