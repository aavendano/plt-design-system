{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://playlovetoys.dev/schemas/editorial-page.json",
  "title": "PlayLoveToys Editorial Page",
  "type": "object",
  "required": ["title", "slug", "blocks"],
  "properties": {
    "title": { "type": "string", "minLength": 1 },
    "slug": { "type": "string", "minLength": 1 },
    "locale": { "type": "string" },
    "blocks": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": ["type", "title"],
            "properties": {
              "type": { "const": "hero" },
              "title": { "type": "string" },
              "description": { "type": "string" },
              "image": { "type": "string" },
              "actions": {
                "type": "array",
                "maxItems": 2,
                "items": {
                  "type": "object",
                  "required": ["label", "href"],
                  "properties": {
                    "label": { "type": "string" },
                    "href": { "type": "string" }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": ["type", "body"],
            "properties": {
              "type": { "const": "rich_text" },
              "body": { "type": "string" }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": ["type", "products"],
            "properties": {
              "type": { "const": "product_grid" },
              "title": { "type": "string" },
              "products": { "type": "array", "items": { "type": "string" } }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": ["type", "title"],
            "properties": {
              "type": { "const": "promo_strip" },
              "title": { "type": "string" },
              "description": { "type": "string" },
              "action": {
                "type": "object",
                "required": ["label", "href"],
                "properties": {
                  "label": { "type": "string" },
                  "href": { "type": "string" }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": ["type", "title"],
            "properties": {
              "type": { "const": "newsletter" },
              "title": { "type": "string" },
              "description": { "type": "string" },
              "placeholder": { "type": "string" },
              "buttonLabel": { "type": "string" }
            },
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "additionalProperties": false
}
