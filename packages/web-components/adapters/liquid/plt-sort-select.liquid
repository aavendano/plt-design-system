{% doc %}
  Liquid adapter for <plt-sort-select>: maps `collection.sort_options` and
  the current sort to the SortSelect contract (Shopify's `sort_by` param).
  Without JavaScript the fallback form has a submit button.

  @param {object[]} options - collection.sort_options
  @param {string} [current] - collection.sort_by | default: collection.default_sort_by
  @param {string} [label] - Default: Sort by
  @param {string} [apply_label]
  @param {string} [script_url] - Bundle URL; 'none' skips the tag
{% enddoc %}
{%- liquid
  assign label_text = label | default: 'Sort by'
  assign apply_text = apply_label | default: 'Apply'
  assign bundle_url = script_url | default: ''
  if bundle_url == blank
    assign bundle_url = 'plt-web-components.bundle.js' | asset_url
  endif
-%}
{%- capture options_json -%}
  [{%- for option in options -%}{"label":{{ option.name | json }},"value":{{ option.value | json }},"selected":{% if option.value == current %}true{% else %}false{% endif %}}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}]
{%- endcapture -%}
<plt-sort-select name="sort_by" label="{{ label_text | escape }}" apply-label="{{ apply_text | escape }}" options="{{ options_json | strip | escape }}">
  <form data-plt-fallback class="plt-sort-select" method="get">
    <label class="theme-label-bold">{{ label_text | escape }}
      <select class="d-select" name="sort_by">
        {%- for option in options -%}
          <option value="{{ option.value | escape }}"{% if option.value == current %} selected{% endif %}>{{ option.name | escape }}</option>
        {%- endfor -%}
      </select>
    </label>
    <button type="submit" class="d-btn d-btn-outline theme-label-bold">{{ apply_text | escape }}</button>
  </form>
</plt-sort-select>
{%- if bundle_url != 'none' -%}<script type="module" src="{{ bundle_url | escape }}"></script>{%- endif -%}
