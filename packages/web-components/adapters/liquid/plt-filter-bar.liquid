{% doc %}
  Liquid adapter for <plt-filter-bar>: maps Shopify storefront filters
  (`collection.filters` / `search.filters`, list type) to the FilterBar
  contract. Shopify list filters are multi-value checkbox groups; price-range
  filters are skipped. Without JavaScript the fallback form submits normally.

  @param {filter[]} filters - collection.filters
  @param {string} [action] - Form action (default: current page)
  @param {string} [all_label] - Label of the "any" option (default: All)
  @param {string} [apply_label]
  @param {string} [orientation] - horizontal (default) or vertical
  @param {string} [sort_by] - Preserved Shopify sort_by value
  @param {string} [search_terms] - Preserved Shopify search query (`q`)
  @param {string} [script_url] - Bundle URL; 'none' skips the tag
{% enddoc %}
{%- liquid
  assign any_label = all_label | default: 'All'
  assign apply_text = apply_label | default: 'Apply'
  assign filter_orientation = orientation | default: 'horizontal'
  assign bundle_url = script_url | default: ''
  if bundle_url == blank
    assign bundle_url = 'plt-web-components.bundle.js' | asset_url
  endif
-%}
{%- capture filters_json -%}
  [
  {%- assign first = true -%}
  {%- for filter in filters -%}
    {%- if filter.type == 'list' -%}
      {%- unless first -%},{%- endunless -%}{%- assign first = false -%}
      {"id":{{ filter.param_name | json }},"label":{{ filter.label | json }},"multiple":true,"options":[
      {%- for value in filter.values -%}{"label":{{ value.label | json }},"value":{{ value.value | json }},"selected":{{ value.active | json }},"count":{{ value.count | default: 0 | json }}}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}
      ]}
    {%- endif -%}
  {%- endfor -%}
  ]
{%- endcapture -%}
{%- capture preserve_json -%}{"sort_by":{{ sort_by | default: '' | json }},"q":{{ search_terms | default: '' | json }}}{%- endcapture -%}
<plt-filter-bar filters="{{ filters_json | strip | escape }}" action="{{ action | escape }}" orientation="{{ filter_orientation | escape }}" preserve="{{ preserve_json | strip | escape }}" labels="{{ apply_text | json | prepend: '{"apply":' | append: '}' | escape }}">
  <form data-plt-fallback class="plt-filter-bar" action="{{ action | escape }}" method="get">
    {%- if sort_by != blank -%}<input type="hidden" name="sort_by" value="{{ sort_by | escape }}">{%- endif -%}
    {%- if search_terms != blank -%}<input type="hidden" name="q" value="{{ search_terms | escape }}">{%- endif -%}
    {%- for filter in filters -%}
      {%- if filter.type == 'list' -%}
        <fieldset class="plt-filter-bar__field plt-filter-bar__group">
          <legend class="theme-label-bold">{{ filter.label | escape }}</legend>
          <ul class="plt-filter-bar__options">
            {%- for value in filter.values -%}
              <li><label class="plt-filter-bar__option"><input class="d-checkbox d-checkbox-primary" type="checkbox" name="{{ filter.param_name | escape }}" value="{{ value.value | escape }}"{% if value.active %} checked{% endif %}> <span>{{ value.label | escape }} <span class="theme-meta">({{ value.count | default: 0 }})</span></span></label></li>
            {%- endfor -%}
          </ul>
        </fieldset>
      {%- endif -%}
    {%- endfor -%}
    <button type="submit" class="d-btn d-btn-primary theme-label-bold">{{ apply_text | escape }}</button>
  </form>
</plt-filter-bar>
{%- if bundle_url != 'none' -%}<script type="module" src="{{ bundle_url | escape }}"></script>{%- endif -%}
