---
/** Astro adapter for <plt-filter-bar>; the fallback is a GET form with a submit button. */
import type { PltFilter, PltFilterBarLabels } from "../../dist/collection/index.js";

interface Props {
  filters: PltFilter[];
  action?: string;
  method?: "get" | "post";
  manual?: boolean;
  labels?: PltFilterBarLabels;
  id?: string;
  class?: string;
}

const { filters, action = "", method = "get", manual = false, labels = {}, id, class: className } = Astro.props;
---

<plt-filter-bar
  id={id}
  class={className}
  filters={JSON.stringify(filters)}
  action={action}
  method={method}
  manual={manual || undefined}
  labels={JSON.stringify(labels)}
>
  <form data-plt-fallback class="plt-filter-bar" action={action} method={method}>
    {filters.map((filter) => (
      <label class="plt-filter-bar__field theme-label-bold">
        {filter.label}
        <select class="d-select" name={filter.id}>
          {filter.options.map((option) => (
            <option value={option.value} selected={option.selected}>{option.label}</option>
          ))}
        </select>
      </label>
    ))}
    <button type="submit" class="d-btn d-btn-primary theme-label-bold">{labels.apply ?? "Apply"}</button>
  </form>
</plt-filter-bar>

<script>
  import "../../dist/collection/define.js";
</script>
