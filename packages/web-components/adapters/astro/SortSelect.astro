---
/** Astro adapter for <plt-sort-select>; the fallback is a GET form with a submit button. */
import type { PltChoice } from "../../dist/collection/index.js";

interface Props {
  options: PltChoice[];
  name?: string;
  label?: string;
  action?: string;
  method?: "get" | "post";
  manual?: boolean;
  applyLabel?: string;
  id?: string;
  class?: string;
}

const { options, name = "sort", label = "Sort by", action = "", method = "get", manual = false, applyLabel = "Apply", id, class: className } = Astro.props;
---

<plt-sort-select
  id={id}
  class={className}
  options={JSON.stringify(options)}
  name={name}
  label={label}
  action={action}
  method={method}
  manual={manual || undefined}
  apply-label={applyLabel}
>
  <form data-plt-fallback class="plt-sort-select" action={action} method={method}>
    <label class="theme-label-bold">
      {label}
      <select class="d-select" name={name}>
        {options.map((option) => <option value={option.value} selected={option.selected}>{option.label}</option>)}
      </select>
    </label>
    <button type="submit" class="d-btn d-btn-outline theme-label-bold">{applyLabel}</button>
  </form>
</plt-sort-select>

<script>
  import "../../dist/collection/define.js";
</script>
