{
  "name": "@playlovetoys/web-components",
  "version": "0.1.0",
  "private": true,
  "description": "Framework-neutral PLT Web Components (Lit) shared by the Liquid, Astro and Hydrogen React frontends.",
  "type": "module",
  "sideEffects": [
    "./dist/*/define.js",
    "./dist/all.js",
    "./dist/*.bundle.js",
    "./src/*/define.ts",
    "./src/all.ts"
  ],
  "files": [
    "dist",
    "src",
    "adapters",
    "README.md"
  ],
  "exports": {
    "./variant-picker": {
      "types": "./dist/variant-picker/index.d.ts",
      "default": "./dist/variant-picker/index.js"
    },
    "./variant-picker/define": {
      "types": "./dist/variant-picker/define.d.ts",
      "default": "./dist/variant-picker/define.js"
    },
    "./variant-picker/resolve": {
      "types": "./dist/variant-picker/resolve.d.ts",
      "default": "./dist/variant-picker/resolve.js"
    },
    "./variant-picker/storefront": {
      "types": "./dist/variant-picker/storefront.d.ts",
      "default": "./dist/variant-picker/storefront.js"
    },
    "./variant-picker/bundle": "./dist/plt-variant-picker.bundle.js",
    "./react/variant-picker": {
      "types": "./dist/react/variant-picker.d.ts",
      "default": "./dist/react/variant-picker.js"
    },
    "./adapters/astro/*": "./adapters/astro/*",
    "./adapters/liquid/*": "./adapters/liquid/*",
    "./quantity-selector": {
      "types": "./dist/quantity-selector/index.d.ts",
      "default": "./dist/quantity-selector/index.js"
    },
    "./quantity-selector/define": {
      "types": "./dist/quantity-selector/define.d.ts",
      "default": "./dist/quantity-selector/define.js"
    },
    "./cart": {
      "types": "./dist/cart/index.d.ts",
      "default": "./dist/cart/index.js"
    },
    "./cart/define": {
      "types": "./dist/cart/define.d.ts",
      "default": "./dist/cart/define.js"
    },
    "./collection": {
      "types": "./dist/collection/index.d.ts",
      "default": "./dist/collection/index.js"
    },
    "./collection/define": {
      "types": "./dist/collection/define.d.ts",
      "default": "./dist/collection/define.js"
    },
    "./product": {
      "types": "./dist/product/index.d.ts",
      "default": "./dist/product/index.js"
    },
    "./product/define": {
      "types": "./dist/product/define.d.ts",
      "default": "./dist/product/define.js"
    },
    "./navigation": {
      "types": "./dist/navigation/index.d.ts",
      "default": "./dist/navigation/index.js"
    },
    "./navigation/define": {
      "types": "./dist/navigation/define.d.ts",
      "default": "./dist/navigation/define.js"
    },
    "./all": {
      "types": "./dist/all.d.ts",
      "default": "./dist/all.js"
    },
    "./bundle": "./dist/plt-web-components.bundle.js",
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check:dist": "node scripts/build.mjs --check",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:browser": "node scripts/build-examples.mjs && vitest run --config vitest.browser.config.ts",
    "size": "node scripts/measure-bundle.mjs",
    "check": "npm run typecheck && npm run check:dist && npm run test && npm run test:browser"
  },
  "dependencies": {
    "lit": "^3.3.1"
  },
  "peerDependencies": {
    "react": ">=18 <20"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.3.8",
    "axe-core": "^4.14.0",
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "liquidjs": "^10.30.0",
    "playwright": "1.56.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
