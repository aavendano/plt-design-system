{
  "name": "@playlovetoys/web-components",
  "version": "0.1.0",
  "private": true,
  "description": "Framework-neutral PLT Web Components (Lit) shared by the Liquid, Astro and Hydrogen React frontends.",
  "type": "module",
  "sideEffects": [
    "./dist/*/define.js",
    "./dist/*.bundle.js"
  ],
  "files": [
    "dist",
    "src",
    "adapters",
    "README.md"
  ],
  "exports": {
    "./variant-picker": {
      "types": "./dist/variant-picker/index.d.ts",
      "default": "./dist/variant-picker/index.js"
    },
    "./variant-picker/define": {
      "types": "./dist/variant-picker/define.d.ts",
      "default": "./dist/variant-picker/define.js"
    },
    "./variant-picker/resolve": {
      "types": "./dist/variant-picker/resolve.d.ts",
      "default": "./dist/variant-picker/resolve.js"
    },
    "./variant-picker/storefront": {
      "types": "./dist/variant-picker/storefront.d.ts",
      "default": "./dist/variant-picker/storefront.js"
    },
    "./variant-picker/bundle": "./dist/plt-variant-picker.bundle.js",
    "./react/variant-picker": {
      "types": "./dist/react/variant-picker.d.ts",
      "default": "./dist/react/variant-picker.js"
    },
    "./adapters/astro/*": "./adapters/astro/*",
    "./adapters/liquid/*": "./adapters/liquid/*"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check:dist": "node scripts/build.mjs --check",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:browser": "node scripts/build-examples.mjs && vitest run --config vitest.browser.config.ts",
    "size": "node scripts/measure-bundle.mjs",
    "check": "npm run typecheck && npm run check:dist && npm run test && npm run test:browser"
  },
  "dependencies": {
    "lit": "^3.3.1"
  },
  "peerDependencies": {
    "react": ">=18 <20"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.3.8",
    "axe-core": "^4.14.0",
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "liquidjs": "^10.30.0",
    "playwright": "1.56.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
