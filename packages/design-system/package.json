{
  "name": "@playlovetoys/design-system",
  "version": "0.7.0",
  "private": true,
  "description": "Portable visual foundations, primitives, composite patterns and cross-platform renderers for Play, love & Toys.",
  "type": "module",
  "scripts": {
    "build:demo": "tailwindcss -i ./demo/demo.css -o ./demo/dist.css --minify",
    "check:conformance": "node scripts/check-daisyui-conformance.mjs",
    "check:renderers": "node scripts/check-renderer-safety.mjs",
    "check": "npm run check:conformance && npm run check:renderers && npm run check:css && npm run check:themes && npm run build:demo && npm run build:themes",
    "build:themes": "node scripts/build-themes.mjs",
    "check:css": "stylelint \"src/patterns.css\" \"src/primitives.css\" \"src/typography.css\" \"src/base.css\" \"src/utilities.css\" \"src/geometry.css\"",
    "check:themes": "node scripts/check-theme-rules.mjs"
  },
  "files": [
    "src",
    "themes",
    "adapters",
    "contracts",
    "renderers",
    "demo",
    "docs",
    "DESIGN.md"
  ],
  "exports": {
    ".": "./src/index.css",
    "./tokens": "./src/tokens.css",
    "./typography": "./src/typography.css",
    "./geometry": "./src/geometry.css",
    "./utilities": "./src/utilities.css",
    "./primitives": "./src/primitives.css",
    "./patterns": "./src/patterns.css",
    "./daisyui": "./src/daisyui-theme.css",
    "./shopify": "./adapters/shopify.css",
    "./astro": "./adapters/astro.css",
    "./contracts": "./contracts/components.md",
    "./renderers/liquid/*": "./renderers/liquid/*",
    "./renderers/astro/*": "./renderers/astro/*",
    "./base": "./src/base.css",
    "./themes/*": "./themes/*.css"
  },
  "peerDependencies": {
    "daisyui": ">=5.7.8 <6",
    "tailwindcss": ">=4 <5"
  },
  "devDependencies": {
    "@tailwindcss/cli": ">=4 <5",
    "daisyui": ">=5.7.8 <6",
    "stylelint": "^17.16.0",
    "tailwindcss": ">=4 <5"
  }
}
