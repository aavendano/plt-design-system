{% comment %}
  ReviewSummary liquid renderer.
  Expects: rating, count, distribution (array of objects with stars, count, percentage)
{% endcomment %}

<div class="plt-review-summary d-card bg-base-100 theme-bordered theme-elevated p-6">
  <div class="flex flex-col md:flex-row gap-8">
    <div class="flex-shrink-0 flex flex-col items-center justify-center">
      <div class="text-5xl font-bold theme-headline-lg">{{ rating }}</div>
      {% include 'commerce/review-rating' with rating: rating, count: nil %}
      <div class="text-sm mt-2 text-base-content/70">Based on {{ count }} reviews</div>
    </div>

    <div class="flex-grow flex flex-col gap-2">
      {% for dist in distribution %}
        <div class="flex items-center gap-4 text-sm">
          <span class="w-12 text-right">{{ dist.stars }} Stars</span>
          <progress class="d-progress d-progress-warning w-full" value="{{ dist.percentage }}" max="100"></progress>
          <span class="w-12">{{ dist.percentage }}%</span>
        </div>
      {% else %}
        {% if count == 0 or count == blank %}
          <div class="text-base-content/60 italic mt-4">No reviews yet.</div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>
