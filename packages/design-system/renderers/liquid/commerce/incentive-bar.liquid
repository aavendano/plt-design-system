{% comment %}
  IncentiveBar liquid renderer.
  Expects: incentives (array of objects with title, description, and optional icon)
{% endcomment %}

<div class="plt-incentive-bar bg-base-200 py-12 border-y border-base-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {% for incentive in incentives %}
        <div class="flex flex-col items-center text-center">
          {% if incentive.icon != blank %}
            <div class="mb-4 text-primary">{{ incentive.icon }}</div>
          {% endif %}
          <h3 class="font-bold text-lg mb-2">{{ incentive.title | escape }}</h3>
          <p class="text-base-content/70 text-sm">{{ incentive.description | escape }}</p>
        </div>
      {% endfor %}
    </div>
  </div>
</div>
