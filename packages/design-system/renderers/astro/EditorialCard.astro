---
interface Props {
  title: string;
  url: string;
  imageUrl?: string;
  imageAlt?: string;
  meta?: string;
  excerpt?: string;
  actionLabel?: string;
}

const {
  title,
  url,
  imageUrl,
  imageAlt = title,
  meta,
  excerpt,
  actionLabel = "Read more",
} = Astro.props;
---

<article class="d-card bg-base-100 theme-bordered theme-elevated plt-media-card plt-editorial-card">
  {imageUrl && (
    <a class="plt-media-card__media" href={url}>
      <img src={imageUrl} alt={imageAlt} loading="lazy" />
    </a>
  )}
  <div class="d-card-body plt-media-card__body">
    <h2 class="d-card-title theme-headline-sm plt-media-card__title">
      <a href={url}>{title}</a>
    </h2>
    {meta && <p class="theme-meta plt-media-card__meta">{meta}</p>}
    {excerpt && <p class="theme-body-lg plt-media-card__description">{excerpt}</p>}
    <div class="d-card-actions plt-media-card__actions">
      <a class="d-btn d-btn-ghost theme-label-bold" href={url}>{actionLabel}</a>
    </div>
  </div>
</article>
