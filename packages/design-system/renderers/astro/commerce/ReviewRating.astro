---
interface Props {
  rating: number;
  maxRating?: number;
  count?: number;
  locale?: string;
}

const { rating, maxRating = 5, count, locale = 'en-US' } = Astro.props;
const displayRating = Math.max(0, Math.min(rating, maxRating));

const i18n = {
  'en-US': { rating: `Rating: ${displayRating} out of ${maxRating}`, noReviews: 'No reviews' },
  'en-CA': { rating: `Rating: ${displayRating} out of ${maxRating}`, noReviews: 'No reviews' },
  'fr-CA': { rating: `Note: ${displayRating} sur ${maxRating}`, noReviews: 'Aucun avis' },
  'es-US': { rating: `Calificación: ${displayRating} de ${maxRating}`, noReviews: 'Sin reseñas' }
};

const labels = i18n[locale as keyof typeof i18n] || i18n['en-US'];
const ariaLabel = count === 0 ? labels.noReviews : labels.rating;
---

<div class="d-rating d-rating-sm" role="img" aria-label={ariaLabel}>
  {Array.from({ length: maxRating }).map((_, i) => {
    const starValue = i + 1;
    let starClass = "d-mask d-mask-star-2 bg-warning";
    if (starValue > displayRating && starValue - displayRating < 1) {
      starClass = "d-mask d-mask-star-2 d-mask-half-1 bg-warning";
    } else if (starValue > displayRating) {
      starClass = "d-mask d-mask-star-2 bg-base-300";
    }
    return (
      <span class={starClass} aria-hidden="true"></span>
    );
  })}
  {count !== undefined && <span class="ml-2 text-sm text-base-content/70">({count})</span>}
</div>
