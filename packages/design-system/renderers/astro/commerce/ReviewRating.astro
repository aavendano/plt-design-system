---
interface Props {
  rating: number;
  maxRating?: number;
  count?: number;
  locale?: string;
}

const { rating, maxRating, count, locale = 'en-US' } = Astro.props;

const parsedMaxRating = Number.isFinite(Number(maxRating)) && Number(maxRating) > 0 ? Math.floor(Number(maxRating)) : 5;
const safeMaxRating = Math.min(parsedMaxRating, 10); // cap excessive values

const parsedRating = Number.isFinite(Number(rating)) ? Number(rating) : 0;
const displayRating = Math.max(0, Math.min(parsedRating, safeMaxRating));

const safeCount = (Number.isFinite(Number(count)) && Number(count) >= 0) ? Number(count) : undefined;

const i18n = {
  'en-US': { rating: `Rating: ${displayRating} out of ${safeMaxRating}`, noReviews: 'No reviews' },
  'en-CA': { rating: `Rating: ${displayRating} out of ${safeMaxRating}`, noReviews: 'No reviews' },
  'fr-CA': { rating: `Note: ${displayRating} sur ${safeMaxRating}`, noReviews: 'Aucun avis' },
  'es-US': { rating: `Calificación: ${displayRating} de ${safeMaxRating}`, noReviews: 'Sin reseñas' }
};

const labels = i18n[locale as keyof typeof i18n] || i18n['en-US'];
const ariaLabel = safeCount === 0 ? labels.noReviews : labels.rating;
---

<div class="d-rating d-rating-sm" role="img" aria-label={ariaLabel}>
  {Array.from({ length: safeMaxRating }).map((_, i) => {
    const starValue = i + 1;
    let starClass = "d-mask d-mask-star-2 bg-warning";
    if (starValue > displayRating && starValue - displayRating < 1) {
      starClass = "d-mask d-mask-star-2 d-mask-half-1 bg-warning";
    } else if (starValue > displayRating) {
      starClass = "d-mask d-mask-star-2 bg-base-300";
    }
    return (
      <span class={starClass} aria-hidden="true"></span>
    );
  })}
  {safeCount !== undefined && <span class="ml-2 text-sm text-base-content/70">({safeCount})</span>}
</div>
