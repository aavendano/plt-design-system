---
interface Incentive {
  icon?: string; // HTML string or SVG for icon
  title: string;
  description: string;
}

interface Props {
  incentives: Incentive[];
}

const { incentives = [] } = Astro.props;
---

<div class="plt-incentive-bar bg-base-200 py-12 border-y border-base-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {incentives.map((incentive) => (
        <div class="flex flex-col items-center text-center">
          {incentive.icon && (
            <div class="mb-4 text-primary" set:html={incentive.icon} />
          )}
          <h3 class="font-bold text-lg mb-2">{incentive.title}</h3>
          <p class="text-base-content/70 text-sm">{incentive.description}</p>
        </div>
      ))}
    </div>
  </div>
</div>
