---
interface Props {
  heading: string;
  body?: string;
  formAction?: string;
  method?: "get" | "post";
  inputName?: string;
  inputPlaceholder?: string;
  actionLabel?: string;
}
const {
  heading,
  body,
  formAction = "#",
  method = "post",
  inputName = "email",
  inputPlaceholder = "Email address",
  actionLabel = "Subscribe",
} = Astro.props;
---

<section class="plt-newsletter">
  <div class="d-card bg-base-100 theme-bordered theme-elevated plt-newsletter__card">
    <div class="d-card-body plt-newsletter__content">
      <h2 class="d-card-title theme-headline-lg">{heading}</h2>
      {body && <p class="theme-body-lg">{body}</p>}
      <form class="plt-newsletter__form" action={formAction} method={method}>
        <input class="d-input" type="email" name={inputName} placeholder={inputPlaceholder} required />
        <button class="d-btn d-btn-primary theme-bordered theme-elevated theme-label-bold" type="submit">{actionLabel}</button>
      </form>
    </div>
  </div>
</section>
