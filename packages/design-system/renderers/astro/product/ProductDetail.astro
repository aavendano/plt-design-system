---
import ResponsiveShopifyImage from "../ui/ResponsiveShopifyImage.astro";

interface ProductImage {
  url: string;
  alt?: string;
}

interface Props {
  title: string;
  /** Formatted price fallback when the `price` slot is not provided. */
  price?: string;
  vendor?: string;
  compareAtPrice?: string;
  badge?: string;
  description?: string;
  images?: ProductImage[];
}

const {
  title,
  price,
  vendor,
  compareAtPrice,
  badge,
  description,
  images = [],
} = Astro.props;

const primary = images[0];
---

<script src="../../../src/commerce/gallery.js"></script>

<section class="plt-product-detail">
  <plt-product-gallery class="plt-product-detail__gallery">
    <slot name="gallery">
      {primary && (
        <div class="plt-product-detail__gallery-main">
          <ResponsiveShopifyImage
            src={primary.url}
            alt={primary.alt || title}
            layout="gallery"
            loading="eager"
          />
        </div>
      )}
      {images.length > 1 && (
        <div class="plt-product-detail__thumbs">
          {images.map((image) => (
            <button type="button" class="plt-product-detail__thumb" aria-label={image.alt || title}>
              <ResponsiveShopifyImage src={image.url} alt="" layout="card" loading="lazy" />
            </button>
          ))}
        </div>
      )}
    </slot>
  </plt-product-gallery>

  <div class="plt-product-detail__buybox">
    {badge && <span class="d-badge d-badge-secondary theme-label-bold">{badge}</span>}
    <h1 class="theme-headline-lg">{title}</h1>
    {vendor && <p class="theme-meta">{vendor}</p>}
    <div class="plt-product-detail__price">
      <slot name="price">
        {price && <span>{price}</span>}
        {compareAtPrice && <span class="plt-product-detail__compare">{compareAtPrice}</span>}
      </slot>
    </div>
    {description && <div class="theme-body-lg plt-product-detail__description">{description}</div>}
    <div>
      <slot name="options" />
    </div>
    <div class="plt-product-detail__actions">
      <slot name="actions" />
    </div>
  </div>
</section>
