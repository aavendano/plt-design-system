---
interface NavLink {
  label: string;
  url: string;
  current?: boolean;
  /** MegaMenu columns; when present the link opens a mega menu panel. */
  columns?: MegaMenuColumn[];
}

interface MegaMenuColumn {
  title: string;
  url?: string;
  children: Array<{ label: string; url: string; current?: boolean }>;
}

interface Props {
  siteName: string;
  links?: NavLink[];
  logoUrl?: string;
  logoAlt?: string;
  homeUrl?: string;
}

const {
  siteName,
  links = [],
  logoUrl,
  logoAlt = siteName,
  homeUrl = "/",
} = Astro.props;
---

<plt-navbar>
<header class="d-navbar plt-navbar" data-plt-navbar>
  <div class="plt-navbar__inner">
    <div class="d-navbar-start gap-2">
      <button
        type="button"
        class="d-btn d-btn-ghost d-btn-square plt-navbar__menu-toggle"
        data-plt-navbar-toggle
        aria-expanded="false"
        aria-controls="plt-navbar-mobile"
        aria-label="Open menu"
      >
        <span aria-hidden="true">☰</span>
      </button>
      <a class="d-btn d-btn-ghost plt-navbar__brand" href={homeUrl} aria-label={siteName}>
        {logoUrl ? <img src={logoUrl} alt={logoAlt} /> : <span class="theme-headline-sm">{siteName}</span>}
      </a>
    </div>

    <div class="d-navbar-center plt-navbar__links">
      <ul class="d-menu d-menu-horizontal px-0">
        {links.map((link, index) => (
          <li>
            <a
              class="theme-label-bold"
              href={link.url}
              aria-current={link.current ? "page" : undefined}
              aria-haspopup={link.columns?.length ? "true" : undefined}
              aria-expanded={link.columns?.length ? "false" : undefined}
              aria-controls={link.columns?.length ? `plt-megamenu-${index}` : undefined}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
      {links.map((link, index) =>
        link.columns?.length ? (
          <div class="plt-megamenu" id={`plt-megamenu-${index}`} data-open="false" role="region" aria-label={link.label}>
            <div class="plt-megamenu__inner">
              {link.columns.map((column) => (
                <div class="plt-megamenu__column">
                  {column.url ? (
                    <a class="plt-megamenu__title theme-label-bold" href={column.url}>{column.title}</a>
                  ) : (
                    <span class="plt-megamenu__title theme-label-bold">{column.title}</span>
                  )}
                  {column.children.length > 0 && (
                    <ul class="plt-megamenu__list">
                      {column.children.map((child) => (
                        <li>
                          <a class="plt-megamenu__link" href={child.url} aria-current={child.current ? "page" : undefined}>{child.label}</a>
                        </li>
                      ))}
                    </ul>
                  )}
                </div>
              ))}
            </div>
          </div>
        ) : null,
      )}
    </div>

    <div class="d-navbar-end plt-navbar__actions">
      <slot name="actions" />
    </div>
  </div>

  <div class="plt-navbar__mobile" id="plt-navbar-mobile" data-open="false" hidden>
    <ul class="d-menu w-full">
      {links.map((link) => (
        <li>
          <a
            class="theme-label-bold"
            href={link.url}
            aria-current={link.current ? "page" : undefined}
          >
            {link.label}
          </a>
          {link.columns?.length ? (
            <ul>
              {link.columns.map((column) => (
                <li>
                  {column.url ? <a href={column.url}>{column.title}</a> : <span class="theme-label-bold">{column.title}</span>}
                  {column.children.length > 0 && (
                    <ul>
                      {column.children.map((child) => (
                        <li><a href={child.url} aria-current={child.current ? "page" : undefined}>{child.label}</a></li>
                      ))}
                    </ul>
                  )}
                </li>
              ))}
            </ul>
          ) : null}
        </li>
      ))}
    </ul>
    <div class="plt-navbar__actions">
      <slot name="mobile-actions" />
    </div>
  </div>
</header>
</plt-navbar>
<script>
  // Behaviour (mobile toggle + mega menu) lives in @playlovetoys/web-components.
  import "../../../../web-components/dist/navigation/define.js";
</script>
