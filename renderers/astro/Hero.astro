---
interface Props {
  heading: string;
  eyebrow?: string;
  body?: string;
  imageUrl?: string;
  imageAlt?: string;
  primaryLabel?: string;
  primaryUrl?: string;
  secondaryLabel?: string;
  secondaryUrl?: string;
}
const { heading, eyebrow, body, imageUrl, imageAlt = heading, primaryLabel, primaryUrl, secondaryLabel, secondaryUrl } = Astro.props;
---

<section class:list={["d-hero", "plt-hero", { "plt-hero--media": Boolean(imageUrl) }]}>
  {imageUrl && <div class="plt-hero__media"><img src={imageUrl} alt={imageAlt} /></div>}
  {imageUrl && <div class="plt-hero__overlay" aria-hidden="true"></div>}
  <div class="d-hero-content plt-hero__content">
    <div class="plt-hero__copy">
      {eyebrow && <span class="d-badge d-badge-secondary theme-label-bold">{eyebrow}</span>}
      <h1 class="plt-headline-lg">{heading}</h1>
      {body && <div class="plt-body-lg">{body}</div>}
      <div class="plt-hero__actions">
        {primaryLabel && primaryUrl && <a class="d-btn d-btn-primary d-btn-lg theme-bordered theme-elevated theme-label-bold" href={primaryUrl}>{primaryLabel}</a>}
        {secondaryLabel && secondaryUrl && <a class="d-btn d-btn-outline d-btn-lg theme-bordered theme-label-bold" href={secondaryUrl}>{secondaryLabel}</a>}
      </div>
    </div>
  </div>
</section>
