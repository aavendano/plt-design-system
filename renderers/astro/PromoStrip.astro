---
interface Props {
  heading: string;
  body?: string;
  actionLabel?: string;
  actionUrl?: string;
  tone?: "primary" | "warning";
}
const { heading, body, actionLabel, actionUrl, tone = "primary" } = Astro.props;
---

<section class:list={["plt-promo-strip", { "plt-promo-strip--warning": tone === "warning" }]}>
  <div class="plt-promo-strip__inner">
    <div class="plt-promo-strip__copy">
      <h2 class="plt-headline-sm">{heading}</h2>
      {body && <p class="plt-body-lg">{body}</p>}
    </div>
    {actionLabel && actionUrl && <a class="d-btn d-btn-secondary theme-bordered theme-elevated theme-label-bold" href={actionUrl}>{actionLabel}</a>}
  </div>
</section>
